# Ticketing backend
PORT=3001

# JumpServer base URL, without a trailing slash
JUMPSERVER_URL=http://192.168.56.100

# Organization used when creating asset tickets
JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002

# Timezone offset used in JumpServer ticket dates
JUMPSERVER_TIMEZONE_OFFSET=+0700

# Team isolation for approvals.
# If set, only these JumpServer User Group names are treated as teams.
# Leave empty to treat all groups except TEAM_GROUPS_IGNORE as teams.
TEAM_GROUPS=
TEAM_GROUPS_IGNORE=Default

# Frontend development proxy target
VITE_PORTAL_API_URL=http://localhost:3001
VITE_JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002
VITE_JUMPSERVER_URL=http://192.168.56.100
