# Ticketing backend
PORT=3001

# JumpServer base URL, without a trailing slash
JUMPSERVER_URL=

# TLS certificate verification for JumpServer HTTPS connections.
# Keep true for normal deployments. Set false for trusted self-signed/expired internal certificates.
JUMPSERVER_TLS_VERIFY=true

# Organization used when creating asset tickets
JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002

# Private token used ONLY to read the global apply_asset Ticket Flow for portal approver detection.
# Keep this on the backend only; never expose it as a VITE_* variable.
JUMPSERVER_SERVICE_TOKEN=

# Timezone offset used in JumpServer ticket dates
JUMPSERVER_TIMEZONE_OFFSET=+0700

# n8n UAM read webhook. Keep these values server-side only.
# If set, only these JumpServer User Group names are treated as teams.
# Leave empty to treat all groups except TEAM_GROUPS_IGNORE as teams.
TEAM_GROUPS=
TEAM_GROUPS_IGNORE=Default

# n8n webhook used by GET /portal-api/uam to read the current UAM JSON.
N8N_UAM_WEBHOOK_URL=
N8N_UAM_WEBHOOK_TOKEN=

# n8n webhook used by POST /portal-api/uam/update to rebuild the UAM database.
# Defaults to N8N_UAM_WEBHOOK_TOKEN when left empty.
N8N_UAM_UPDATE_WEBHOOK_URL=
N8N_UAM_UPDATE_WEBHOOK_TOKEN=

# Frontend development proxy target
VITE_PORTAL_API_URL=http://localhost:3001
VITE_JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002
VITE_JUMPSERVER_URL=
